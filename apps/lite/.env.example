# On Hostinger, set these in the web app's Environment variables screen
# instead of uploading a .env file. For local development, copy to .env.local.

# MySQL / MariaDB database (hPanel -> Databases -> MySQL Databases).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_tracking
DB_USER=u000000000_tracking
DB_PASSWORD=change-me

# Signs click IDs. At least 16 random characters. Never change it once live:
# conversions for older clicks would be rejected. Using the same value as the
# VPS version keeps click IDs valid if you move there later.
CLICK_SECRET=change-me-to-a-long-random-string

# Dashboard login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-another-long-random-string
SECURE_COOKIES=true

# Secret for the cron URL: /api/cron?key=...
CRON_SECRET=change-me-too

# Public URL of this app, used to show tracking links, e.g. https://trk.ossaward.org
TRACKING_BASE_URL=http://localhost:3000
# Where unknown or paused links send visitors. Empty = 404.
FALLBACK_URL=

# Network currency (ISO code) and the timezone the dashboard shows times in.
CURRENCY=USD
DISPLAY_TIMEZONE=UTC

# How long raw clicks are kept. Hourly stats and conversions are kept forever.
CLICK_RETENTION_DAYS=90
