# Copy to .env and change every value before using anywhere but your laptop.

# Signs click IDs. At least 16 random characters. Never change it once live:
# conversions for older clicks would be rejected.
CLICK_SECRET=change-me-to-a-long-random-string

POSTGRES_PASSWORD=tracking
CLICKHOUSE_PASSWORD=tracking

# Admin dashboard login (Phase 1 has a single admin account).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Signs the dashboard session cookie. At least 32 random characters.
SESSION_SECRET=change-me-to-another-long-random-string

# Public base URL of the tracker, used to show tracking links in the
# dashboard, e.g. https://trk.yourbrand.in
TRACKING_BASE_URL=http://localhost:8080
# Where unknown or paused links send visitors. Empty = 404.
FALLBACK_URL=
# true only when the tracker sits behind your own proxy or Cloudflare.
TRUST_PROXY=false
# true when the dashboard is served over HTTPS.
SECURE_COOKIES=false

# --- Production (Hostinger VPS) only, see docs/DEPLOY-HOSTINGER.md ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# TRACKING_DOMAIN=trk.yourbrand.in
# ADMIN_DOMAIN=admin.yourbrand.in
# ACME_EMAIL=you@yourbrand.in
